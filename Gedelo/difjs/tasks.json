{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Iniciar servidor local",
            "type": "process",
            "command": "node",
            "args": [
                "${workspaceFolder}\\.vscode\\server.js"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^Servidor listo en http://localhost:5500$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Iniciando servidor local en el puerto 5500\\.\\.\\.$",
                    "endsPattern": "^Servidor listo en http://localhost:5500$"
                }
            }
        }
    ]
}
